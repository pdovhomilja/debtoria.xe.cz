  "privacy": {
    "title": "Zásady ochrany osobních údajů",
    "intro": "Tento dokument vysvětluje, jak na této platformě zpracováváme osobní údaje. Jedná se o předběžný text čekající na finální schválení právním oddělením a bude aktualizován před ostrým spuštěním.",
    "controller": {
      "title": "Správce údajů",
      "body": "[Bude upřesněno právním oddělením: obchodní firma, sídlo, IČO a kontaktní údaje správce osobních údajů.]"
    },
    "purposes": {
      "title": "Účely zpracování",
      "body": "Osobní údaje zpracováváme za účelem provozu tržiště: zakládání účtů a organizací, ověření totožnosti (KYC), zadávání a správu vymáhacích případů, párování případů s vymáhacími agenturami, zpracování podpisů a plateb, komunikaci s dlužníky a řešení sporů a podpory."
    },
    "legalBases": {
      "title": "Právní tituly",
      "body": "Zpracování je založeno na: plnění smlouvy s Vámi (správa účtu a případů), oprávněném zájmu (párování na tržišti, prevence podvodů, zlepšování služby), právní povinnosti (KYC/AML, účetnictví, uchovávání) a souhlasu, je-li výslovně vyžádán."
    },
    "recipients": {
      "title": "Příjemci údajů",
      "body": "Vymáhací agentura, které je případ přidělen, obdrží údaje o případu a dlužníkovi nezbytné k výkonu mandátu. Agentury vystupují jako samostatní správci (případně zpracovatelé, dle mandátu) těchto údajů — přesné rozdělení rolí správce/zpracovatel [bude upřesněno právním oddělením]. Údaje dále sdílíme s poskytovateli podpisových a platebních služeb a s orgány veřejné moci, vyžaduje-li to zákon."
    },
    "retention": {
      "title": "Doba uchování",
      "body": "Údaje o případech a finanční záznamy uchováváme po dobu trvání případu a 3 roky po jeho uzavření z právních a účetních důvodů, poté jsou osobní údaje dlužníka anonymizovány. O dřívější výmaz můžete požádat, pokud se neuplatní zákonná povinnost uchování."
    },
    "rights": {
      "title": "Vaše práva",
      "body": "Máte právo na přístup k osobním údajům, jejich opravu, výmaz, omezení zpracování a přenositelnost a právo vznést námitku proti určitému zpracování. Pro uplatnění těchto práv nás kontaktujte na níže uvedených kontaktech."
    },
    "complaints": {
      "title": "Právo podat stížnost",
      "body": "Domníváte-li se, že Vaše údaje byly zpracovány v rozporu se zákonem, můžete podat stížnost u dozorového úřadu: v České republice u Úřadu pro ochranu osobních údajů (ÚOOÚ, www.uoou.cz); na Slovensku u Úradu na ochranu osobných údajov SR (ÚOOÚ SR, www.dataprotection.gov.sk)."
    },
    "contact": {
      "title": "Kontakt",
      "body": "[Bude upřesněno právním oddělením: kontaktní e-mail/adresa pro dotazy ohledně ochrany osobních údajů a případně pověřenec pro ochranu osobních údajů.]"
