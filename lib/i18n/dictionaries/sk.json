  "privacy": {
    "title": "Zásady ochrany osobných údajov",
    "intro": "Tento dokument vysvetľuje, ako na tejto platforme spracúvame osobné údaje. Ide o predbežný text čakajúci na finálne schválenie právnym oddelením a bude aktualizovaný pred ostrým spustením.",
    "controller": {
      "title": "Prevádzkovateľ",
      "body": "[Bude upresnené právnym oddelením: obchodné meno, sídlo, IČO a kontaktné údaje prevádzkovateľa osobných údajov.]"
    },
    "purposes": {
      "title": "Účely spracúvania",
      "body": "Osobné údaje spracúvame na účely prevádzky trhoviska: zakladanie účtov a organizácií, overenie totožnosti (KYC), zadávanie a správu vymáhacích prípadov, párovanie prípadov s vymáhacími agentúrami, spracovanie podpisov a platieb, komunikáciu s dlžníkmi a riešenie sporov a podpory."
    },
    "legalBases": {
      "title": "Právne základy",
      "body": "Spracúvanie je založené na: plnení zmluvy s Vami (správa účtu a prípadov), oprávnenom záujme (párovanie na trhovisku, prevencia podvodov, zlepšovanie služby), zákonnej povinnosti (KYC/AML, účtovníctvo, uchovávanie) a súhlase, ak je výslovne vyžiadaný."
    },
    "recipients": {
      "title": "Príjemcovia údajov",
      "body": "Vymáhacia agentúra, ktorej je prípad pridelený, dostane údaje o prípade a dlžníkovi nevyhnutné na výkon mandátu. Agentúry vystupujú ako samostatní prevádzkovatelia (prípadne sprostredkovatelia, podľa mandátu) týchto údajov — presné rozdelenie rolí prevádzkovateľ/sprostredkovateľ [bude upresnené právnym oddelením]. Údaje ďalej zdieľame s poskytovateľmi podpisových a platobných služieb a s orgánmi verejnej moci, ak to vyžaduje zákon."
    },
    "retention": {
      "title": "Doba uchovávania",
      "body": "Údaje o prípadoch a finančné záznamy uchovávame počas trvania prípadu a 3 roky po jeho uzavretí z právnych a účtovných dôvodov, potom sú osobné údaje dlžníka anonymizované. O skorší výmaz môžete požiadať, ak sa neuplatňuje zákonná povinnosť uchovávania."
    },
    "rights": {
      "title": "Vaše práva",
      "body": "Máte právo na prístup k osobným údajom, ich opravu, výmaz, obmedzenie spracúvania a prenosnosť a právo namietať proti určitému spracúvaniu. Na uplatnenie týchto práv nás kontaktujte na nižšie uvedených kontaktoch."
    },
    "complaints": {
      "title": "Právo podať sťažnosť",
      "body": "Ak sa domnievate, že Vaše údaje boli spracované v rozpore so zákonom, môžete podať sťažnosť dozornému orgánu: v Českej republike Úradu pre ochranu osobných údajov (ÚOOÚ, www.uoou.cz); na Slovensku Úradu na ochranu osobných údajov SR (ÚOOÚ SR, www.dataprotection.gov.sk)."
    },
