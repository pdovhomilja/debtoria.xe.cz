# Copy to .env and fill in values. No real secrets belong in this file.

# docker-compose (Postgres container + DATABASE_URL must agree).
# Host port is 5464 (not the Postgres default 5432, and not 5433) because
# 5432/5433 are often already taken locally — see docker-compose.yml.
POSTGRES_USER=<choose-a-db-user>
POSTGRES_PASSWORD=<choose-a-db-password>
POSTGRES_DB=vymahaci

DATABASE_URL="postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5464/vymahaci"

# Generate with: openssl rand -hex 32
SESSION_SECRET=<generate-a-random-secret>

# MinIO — also used as the container's root credentials by docker-compose
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY=<choose-a-minio-key>
MINIO_SECRET_KEY=<choose-a-minio-secret>
MINIO_BUCKET="vymahaci"

APP_URL="http://localhost:3000"

# Demo account passwords written by `pnpm db:seed` (sandbox only — pick your own)
SEED_ADMIN_PASSWORD=<choose-a-password>
SEED_CREDITOR_PASSWORD=<choose-a-password>
SEED_AGENCY_PASSWORD=<choose-a-password>
